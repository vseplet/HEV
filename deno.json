{
  "name": "@vseplet/hev",
  "version": "0.4.0",
  "exports": "./src/cli.ts",
  "lock": false,
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@1.0.0-rc.7",
    "@std/path": "jsr:@std/path@1.0.8",
    "@std/assert": "jsr:@std/assert@1",
    "hono": "jsr:@hono/hono@4.6.20",
    "@vseplet/morph": "jsr:@vseplet/morph",
    "@/shared/": "./src/shared/",
    "@/daemon/": "./src/daemon/",
    "@/cli/": "./src/cli/"
  },
  "tasks": {
    "cli": "deno run --allow-all src/cli.ts",
    "daemon": "deno run --allow-all src/daemon.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check src/**/*.ts tests/**/*.ts",
    "test": "deno test --allow-all tests/"
  },
  "fmt": {
    "exclude": ["*.md", "deno.json"]
  },
  "lint": {
    "exclude": ["*.md", "deno.json"]
  }
}
